---
import Layout from '../layouts/Layout.astro';

const flavors = [
  { name: 'Astro', status: 'main', description: 'The primary framework for this portfolio' },
  { name: 'Next.js', status: 'coming', description: 'React framework for server-rendered applications' },
  { name: 'Nuxt.js', status: 'coming', description: 'Vue framework for server-rendered applications' },
  { name: 'SvelteKit', status: 'coming', description: 'Svelte framework for modern web applications' },
  { name: 'Gatsby', status: 'coming', description: 'React framework for static site generation' },
];

const portfolioUrl = 'https://foxphantom203.github.io';
---

<Layout title="Portfolio - Framework Flavors">
  <main style="min-height: 100vh; padding: 2rem; max-width: 800px; margin: 0 auto;">
    <section style="text-align: center; margin-bottom: 3rem;">
      <h1 style="font-size: 2.5rem; font-weight: bold; margin-bottom: 1rem;" class="gradient-text">
        Framework Flavors
      </h1>
      <p style="font-size: 1.25rem; color: #D1D5DB;">
        This portfolio supports multiple framework flavors. Here's what's available:
      </p>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 1.5rem; text-align: center;">Available Flavors</h2>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        {flavors.map((flavor) => (
          <div 
            class:list={[
              flavor.status === 'main' ? "card-main" : "card-coming"
            ]}
            style="padding: 1.5rem; border-radius: 0.5rem; border: 2px solid; transition: all 0.3s ease;"
          >
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <h3 style="font-size: 1.25rem; font-weight: bold;">
                {flavor.name}
              </h3>
              {flavor.status === 'main' ? (
                <span style="padding: 0.5rem 1rem; background-color: #10B981; color: white; font-size: 0.875rem; font-weight: 500; border-radius: 9999px;">
                  Main
                </span>
              ) : (
                <span style="padding: 0.5rem 1rem; background-color: #F59E0B; color: white; font-size: 0.875rem; font-weight: 500; border-radius: 9999px;">
                  Coming Soon
                </span>
              )}
            </div>
            <p style="color: #9CA3AF; font-size: 0.875rem; margin-bottom: 1rem;">{flavor.description}</p>
            
            {flavor.status === 'main' && (
              <p style="color: #10B981; font-size: 0.875rem; font-style: italic;">Currently active</p>
            )}
          </div>
        ))}
      </div>
    </section>

    <section style="text-align: center;">
      <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 1.5rem;">Visit My Portfolio</h2>
      <p style="color: #D1D5DB; margin-bottom: 1.5rem; max-width: 42rem; margin-left: auto; margin-right: auto;">
        Check out my main portfolio website built with various technologies and frameworks.
      </p>
      
      <a 
        href={portfolioUrl}
        class="gradient-bg"
        style="display: inline-block; padding: 1rem 2rem; color: white; font-weight: 500; border-radius: 0.5rem; text-decoration: none; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); transition: all 0.3s ease;"
        target="_blank"
        rel="noopener noreferrer"
      >
        Visit foxphantom203.github.io
      </a>
    </section>

    <footer style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid #374151; text-align: center; color: #9CA3AF;">
      <p>Built with Astro & ❤️</p>
    </footer>
  </main>
</Layout>
