---
interface Props {
  title?: string;
}

const { title = 'FoxPhantom203 - Portfolio' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="FoxPhantom203's Portfolio">
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="bg-gray-900 text-white font-sans">
  <slot />
</body>
</html>
